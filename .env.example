DJANGO_SECRET_KEY=replace-with-a-long-random-local-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_HOST=127.0.0.1
DJANGO_PORT=8000
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=your-supported-model-id

# Wren MCP endpoint. Blank disables discovery. With dev_jaffle it must equal
# AYCE_DEV_WREN_MCP_URL. It is not query authorization by itself.
WREN_MCP_URL=http://127.0.0.1:18080/mcp

# Shipped default. Blank or off attaches no analytics tools.
# dev_jaffle is synthetic loopback DEV only. Any other value, including scoped,
# fails startup. off ignores the DEV variables below.
AYCE_ANALYTICS_MODE=off

# Required together only when AYCE_ANALYTICS_MODE=dev_jaffle.
# DJANGO_DEBUG must be true. Both URLs must be the same absolute loopback
# HTTP(S) URL: literal host 127.0.0.1 or [::1], explicit port, no userinfo,
# query, or fragment. Project must be exactly jaffle-wren.
# AYCE_DEV_JAFFLE_CONFIRMED=true attests that this endpoint is the unchanged
# synthetic Jaffle deployment. That attestation, the loopback host, the project
# name, and catalog hashes are not physical isolation.
AYCE_DEV_WREN_MCP_URL=
AYCE_DEV_WREN_PROJECT=
AYCE_DEV_JAFFLE_CONFIRMED=false

# Chat attachment limits. Each conversation keeps its own uploads, so these
# quotas apply per thread; the defaults below are also the starting point for
# an existing deployment. Whole numbers, 1..2147483647.
CHAT_MAX_FILES_PER_THREAD=5
CHAT_MAX_FILES_PER_TURN=5
CHAT_MAX_FILE_BYTES=5242880
CHAT_MAX_TEXT_BYTES_PER_FILE=65536
CHAT_MAX_TEXT_BYTES_PER_THREAD=262144

# Application input-plus-reserved-output token budget per model request and
# the maximum output tokens requested from the provider per completion.
LLM_CONTEXT_WINDOW=131072
LLM_MAX_OUTPUT_TOKENS=8192

# Whether ordinary-chat activity shows detailed tool names, arguments, and
# reasoning steps (true) or generic status indicators (false). A run that
# attached synthetic DEV tools stays generic even when this is true.
CHAT_SHOW_REASONING_DETAIL=true
